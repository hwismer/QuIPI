# QuIPI HuMu app. The data folder is not copied in: ShinyProxy mounts it at /quipi_humu/quipi_humu_data.
FROM quipi_base

WORKDIR /quipi_humu
COPY --chown=$MAMBA_USER:$MAMBA_USER quipi_humu .

EXPOSE 8081

# A single process, since a Shiny session must always reach the same process
CMD ["uvicorn", "humu_app:app", "--host", "0.0.0.0", "--port", "8081"]
