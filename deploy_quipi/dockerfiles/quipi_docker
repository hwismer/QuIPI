# QuIPI app. The data folder is not copied in: ShinyProxy mounts it at /quipi_core/quipi_data.
FROM quipi_base

WORKDIR /quipi_core
COPY --chown=$MAMBA_USER:$MAMBA_USER quipi_core .

EXPOSE 3838

# A single process, since a Shiny session must always reach the same process
CMD ["uvicorn", "quipi_app:app", "--host", "0.0.0.0", "--port", "3838"]
